# ==============================================================================
# Single Medical Shop Review & Customer Card System — Environment Configuration
# ==============================================================================

# Application Base URL (MUST be production URL for production QR generation)
NEXT_PUBLIC_APP_URL="https://pharmacy.example.com"

# Owner Admin Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="" # Bcrypt hash of owner password
ADMIN_SESSION_SECRET="super-secret-random-key-at-least-32-chars-long"

# Database Configuration (PostgreSQL / Neon connection string)
# Neon connection string example: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AI Provider Configuration (Server-Side ONLY — NEVER expose to client)
AI_PROVIDER="ollama" # Options: 'ollama' | 'gemini' | 'openai' | 'mock'
OLLAMA_API_KEY=""
OLLAMA_BASE_URL="https://ollama.com/v1"
OLLAMA_MODEL="gemma4:31b"

# Legacy / Secondary Provider (Gemini)
AI_API_KEY=""

# Rate Limiting & Abuse Prevention
AI_RATE_LIMIT_PER_MINUTE=10
