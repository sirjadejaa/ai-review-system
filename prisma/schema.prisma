// Prisma Schema for Single Medical Shop / Pharmacy AI Review & Customer Card System
// Strictly Single-Tenant. No multi-tenancy or SaaS constructs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single Pharmacy Shop Settings (Singleton record: id = "default_shop")
model ShopSettings {
  id               String   @id @default("default_shop")
  shopName         String
  tagline          String?
  logoUrl          String?
  primaryColor     String?  @default("#123e35")
  secondaryColor   String?  @default("#4a6b61")
  accentColor      String?  @default("#92bfa9")
  phoneNumber      String?
  whatsappNumber   String?
  emergencyContact String?
  address          String?
  googleMapsUrl    String?
  googleReviewUrl  String?
  websiteUrl       String?
  socialLinks      String?  @default("[]")
  openingHours     String   @default("[]") // Structured JSON array: [{"days":"Mon-Sat","hours":"8:00 AM - 10:00 PM"}]
  isEmergencyOpen  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Internal Customer Feedback (Private to Owner; 1-5 Stars)
model Feedback {
  id              String   @id @default(cuid())
  rating          Int      // 1 to 5 (enforced by application validation and database schema)
  tags            String   @default("[]") // JSON array string of tags: e.g. ["Quick Service", "Medicines in Stock"]
  notes           String?  // Optional customer notes
  customerContact String?  // 100% voluntary phone/email (NO mandatory requirement)
  status          String   @default("NEW") // "NEW", "REVIEWED", "RESOLVED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

/// Boutique Store Offers & Promotional Deals
model Offer {
  id           String    @id @default(cuid())
  title        String
  description  String?
  badge        String?   // e.g. "10% OFF", "FESTIVE SALE", "SPECIAL"
  imageUrl     String?   // Banner or promotional image
  discountInfo String?   // e.g. "Flat 30% Off", "Buy 1 Get 1"
  startDate    DateTime? // Optional scheduled start date
  validUntil   DateTime? // Expiration date / end date
  terms        String?   // Optional terms and conditions
  offerUrl     String?   // Optional external link
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@index([validUntil])
  @@index([startDate])
}

/// Clothing Store Featured & Catalog Products
model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  imageUrl      String?
  category      String   @default("General") // e.g. "Women's Wear", "Men's Wear", "Traditional Wear", "Ethnic Wear", "Accessories"
  price         Float?
  originalPrice Float?
  sizes         String   @default("[]") // JSON array string e.g. ["S", "M", "L", "XL"]
  colors        String   @default("[]") // JSON array string e.g. ["Beige", "Noir", "Camel"]
  isFeatured    Boolean  @default(true)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  productUrl    String?  // Optional external link or product detail URL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, isFeatured, sortOrder])
  @@index([category])
}

/// Privacy-Preserving Analytics Events (Tracking Google Review Clicks, NOT Confirmed Reviews)
model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String   // "QR_SCAN", "GOOGLE_REVIEW_CLICK", "CALL_CLICK", "WHATSAPP_CLICK", "DIRECTIONS_CLICK"
  source    String?  // Attribution: e.g. "QR", "DIRECT", "COUNTER", "BILL"
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
}

/// Owner Admin User Foundation (Single Store Owner Account)
model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String         // Strictly password hash (Bcrypt); NEVER plaintext
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

/// Server-Side Authenticated Session for Pharmacy Owner
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique // SHA-256 hash of the random 32-byte session token
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}
