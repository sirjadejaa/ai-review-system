// Prisma Schema for Single Medical Shop / Pharmacy AI Review & Customer Card System
// Strictly Single-Tenant. No multi-tenancy or SaaS constructs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single Restaurant / Café Settings (Singleton record: id = "default_shop")
model ShopSettings {
  id               String   @id @default("default_shop")
  shopName         String
  tagline          String?
  logoUrl          String?
  coverImageUrl    String?
  restaurantType   String?  @default("Café & Restaurant")
  cuisineTypes     String?  @default("[]") // JSON array e.g. ["Italian", "Continental", "Beverages"]
  primaryColor     String?  @default("#25221F")
  secondaryColor   String?  @default("#57483D")
  accentColor      String?  @default("#B78348")
  phoneNumber      String?
  whatsappNumber   String?
  emergencyContact String?
  address          String?
  googleMapsUrl    String?
  googleReviewUrl  String?
  websiteUrl       String?
  socialLinks      String?  @default("[]")
  openingHours     String   @default("[]") // Structured JSON array: [{"days":"Mon-Sun","hours":"8:00 AM - 11:00 PM"}]
  isEmergencyOpen  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Internal Customer Feedback (Private to Owner; 1-5 Stars)
model Feedback {
  id              String   @id @default(cuid())
  rating          Int      // 1 to 5 (enforced by application validation and database schema)
  tags            String   @default("[]") // JSON array string of tags: e.g. ["Quick Service", "Medicines in Stock"]
  notes           String?  // Optional customer notes
  customerContact String?  // 100% voluntary phone/email (NO mandatory requirement)
  status          String   @default("NEW") // "NEW", "REVIEWED", "RESOLVED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

/// Boutique Store Offers & Promotional Deals
model Offer {
  id           String    @id @default(cuid())
  title        String
  description  String?
  badge        String?   // e.g. "10% OFF", "FESTIVE SALE", "SPECIAL"
  imageUrl     String?   // Banner or promotional image
  discountInfo String?   // e.g. "Flat 30% Off", "Buy 1 Get 1"
  startDate    DateTime? // Optional scheduled start date
  validUntil   DateTime? // Expiration date / end date
  terms        String?   // Optional terms and conditions
  offerUrl     String?   // Optional external link
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@index([validUntil])
  @@index([startDate])
}

/// Restaurant & Café Digital Menu Category
model MenuCategory {
  id          String     @id @default(cuid())
  name        String
  description String?
  icon        String?    // e.g. "Pizza", "Coffee", "UtensilsCrossed", "IceCream", etc.
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]

  @@index([isActive, sortOrder])
}

/// Restaurant & Café Food Item / Menu Item
model MenuItem {
  id            String        @id @default(cuid())
  name          String
  description   String?
  imageUrl      String?
  categoryId    String?
  category      MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName  String        @default("General")
  price         Float
  originalPrice Float?
  isVeg         Boolean       @default(true) // true = Veg, false = Non-Veg
  dietaryLabels String        @default("[]") // JSON array e.g. ["Vegan", "Gluten-Free", "Chef's Special"]
  spiceLevel    Int           @default(0)    // 0: None, 1: Mild, 2: Medium, 3: Spicy
  servingInfo   String?                      // e.g. "Serves 1-2", "300ml", "8 slices"
  variants      String        @default("[]") // JSON array: [{"name":"Small","price":199},{"name":"Large","price":299}]
  addons        String        @default("[]") // JSON array: [{"name":"Extra Cheese","price":40}]
  isAvailable   Boolean       @default(true)
  isFeatured    Boolean       @default(false)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([categoryId, isAvailable, sortOrder])
  @@index([isFeatured])
}

/// Clothing Store Featured & Catalog Products (Legacy / Backwards Compatibility)
model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  imageUrl      String?
  category      String   @default("General") // e.g. "Women's Wear", "Men's Wear", "Traditional Wear", "Ethnic Wear", "Accessories"
  price         Float?
  originalPrice Float?
  sizes         String   @default("[]") // JSON array string e.g. ["S", "M", "L", "XL"]
  colors        String   @default("[]") // JSON array string e.g. ["Beige", "Noir", "Camel"]
  isFeatured    Boolean  @default(true)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  productUrl    String?  // Optional external link or product detail URL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, isFeatured, sortOrder])
  @@index([category])
}

/// Privacy-Preserving Analytics Events (Tracking Google Review Clicks, NOT Confirmed Reviews)
model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String   // "QR_SCAN", "GOOGLE_REVIEW_CLICK", "CALL_CLICK", "WHATSAPP_CLICK", "DIRECTIONS_CLICK"
  source    String?  // Attribution: e.g. "QR", "DIRECT", "COUNTER", "BILL"
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
}

/// Owner Admin User Foundation (Single Store Owner Account)
model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String         // Strictly password hash (Bcrypt); NEVER plaintext
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

/// Server-Side Authenticated Session for Pharmacy Owner
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique // SHA-256 hash of the random 32-byte session token
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

/// Google Business Profile OAuth Connection for Store Owner (Singleton: id = "default_connection")
model GoogleBusinessAccount {
  id                    String    @id @default("default_connection")
  accountId             String?   // Google Account Resource Name e.g. "accounts/1029384756..."
  accountName           String?   // Google Account Display Name
  locationId            String?   // Google Location Resource Name e.g. "locations/987654321..."
  locationName          String?   // Store Location Name e.g. "Maison & Thread - MG Road"
  accessTokenEncrypted  String?   @db.Text
  refreshTokenEncrypted String?   @db.Text
  tokenExpiresAt        DateTime?
  scopes                String?   // Space-separated granted scopes
  isConnected           Boolean   @default(false)
  lastSyncAt            DateTime?
  lastSyncError         String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Google Business Profile Review Synchronized via Official Google API
model GoogleReview {
  id               String                   @id @default(cuid())
  googleReviewId   String                   @unique // Google's unique review name/id
  reviewerName     String
  reviewerPhotoUrl String?
  starRating       Int                      // 1 to 5
  comment          String?                  @db.Text
  reviewCreatedAt  DateTime
  reviewUpdatedAt  DateTime?
  replyText        String?                  @db.Text
  replyUpdatedAt   DateTime?
  replyStatus      String                   @default("UNREPLIED") // "UNREPLIED", "DRAFT_CREATED", "REPLIED"
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  drafts           GoogleReviewReplyDraft[]

  @@index([replyStatus])
  @@index([starRating])
  @@index([reviewCreatedAt])
}

/// AI-Generated & Edited Owner Reply Drafts for Google Reviews
model GoogleReviewReplyDraft {
  id          String       @id @default(cuid())
  reviewId    String
  draftText   String       @db.Text
  language    String       @default("en") // 'en' | 'hi' | 'gu'
  isApproved  Boolean      @default(false)
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  review      GoogleReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([language])
}
